<?xml version="1.0"?>
<mujoco model="assembly">
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <texture name="T_asmbly_met" type="cube" file="textures/metal1.png"/>
    <material name="asmbly_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>
    <material name="asmbly_green" rgba="0 .5 0 1" shininess="1" reflectance=".7" specular=".5"/>
    <material name="asmbly_metal" rgba=".65 .65 .65 1" texture="T_asmbly_met" shininess="1" reflectance=".7" specular=".5"/>

    <mesh name="assembly_peg_handle" file="objects/assembly/meshes/assembly_peg_handle.stl" scale="0.75 0.75 0.75"/>
    <mesh name="assembly_peg_ring" file="objects/assembly/meshes/assembly_peg_ring.stl" scale="0.75 0.75 0.75"/>
    <mesh name="assembly_peg_rod" file="objects/assembly/meshes/assembly_peg_rod.stl" scale="0.75 0.75 0.75"/>
  </asset>

  <default>
    <default class="asmbly_base">
      <joint armature="0.001" damping="2" limited="true"/>
      <geom conaffinity="0" contype="0" group="1" type="mesh"/>
    </default>
    <default class="asmbly_col">
      <geom conaffinity="1" condim="4" contype="1" group="4" material="asmbly_col"
            friction="2.0 0.05 0.01" solimp="0.995 0.999 0.0005" solref="0.008 1"/>
    </default>
  </default>

  <worldbody>
    <!-- RoundNut (扳手/圆环) - 可被抓取移动 -->
    <body name="round_nut" pos="0.4 0.1 0.46" euler="0 0 3.1416" childclass="asmbly_base">
      <freejoint name="round_nut:joint"/>
      <inertial mass="0.12" pos="0 0 0" diaginertia="0.0025 0.0025 0.0025"/>

      <!-- Visual meshes -->
      <geom material="asmbly_metal" mesh="assembly_peg_ring"/>
      <geom material="asmbly_green" mesh="assembly_peg_handle" pos="0 -0.0975 0" name="WrenchHandle"/>
      <geom material="asmbly_metal" euler="1.57 0 0" pos="0 -0.075 0" size="0.009 0.0375" type="cylinder"/>

      <!-- Collision geoms (ring perimeter capsules) -->
      <geom class="asmbly_col" euler="1.57 0 0" pos="0.039 0 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="0 1.57 0" pos="0 0.039 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="1.57 0.785 0.785" pos="0.0295 0.0295 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="1.57 0 0" pos="-0.039 0.0 0.0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="0 1.57 0" pos="0.0 -0.039 0.0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="1.57 -0.785 -0.785" pos="-0.0295 0.0295 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="1.57 0.785 0.785" pos="-0.0295 -0.0295 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <geom class="asmbly_col" euler="1.57 -0.785 -0.785" pos="0.0295 -0.0295 0" size="0.011 0.0105" type="capsule" mass=".02"/>
      <!-- Handle collision -->
      <geom class="asmbly_col" pos="0 -0.0975 0" size="0.01425 0.0285 0.012" type="box" mass=".04"/>
      <!-- Rod collision -->
      <geom class="asmbly_col" euler="1.57 0 0" pos="0 -0.075 0" size="0.013 0.045" type="cylinder" mass=".02"/>
    </body>

    <!-- Peg (圆柱销) - 静态固定在桌面上 -->
    <body name="peg" pos="0.4 -0.15 0.425">
      <geom material="asmbly_metal" pos="0 0 0" rgba="1 0.3 0.3 1" size="0.012 0.045" type="cylinder"
            conaffinity="1" contype="1" group="1" friction="1 0.005 0.0001"/>
      <site name="pegTop" pos="0 0 0.0375" size="0.00375" rgba="0 0.8 0 1"/>
    </body>
  </worldbody>
</mujoco>
